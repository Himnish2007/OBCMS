PORT=4000
JWT_SECRET=change-this-to-a-strong-random-secret
DEMO_MODE=true
NODE_ENV=production
# Comma-separated list of allowed frontend origins. Leave unset for local/demo use
# (reflects request origin); set explicitly before a real production deploy, e.g.:
# ALLOWED_ORIGINS=https://obcms.himnish.example
ALLOWED_ORIGINS=
# Optional: point db data at a persistent volume mount on Railway (e.g. /app/data)
# so users, coach assignments and notification settings survive redeploys.
DATA_DIR=
